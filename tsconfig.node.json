{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.screenshots.config.ts",
    "e2e/**/*.ts",
    "eslint.config.js"
  ]
}
